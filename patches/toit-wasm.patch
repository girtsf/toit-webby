+#ifdef TOIT_WASM
+// Wasm has no virtual memory: emscripten's mmap allocates and zeroes the whole
+// range, so reserving the 512MB heap up front would touch 512MB. Take ranges
+// straight from sbrk instead. Memory above the break has never been used (the
+// allocator is built with MORECORE_CANNOT_TRIM), so it is already zero, and
+// the browser only commits pages once they are touched. sbrk can't give memory
+// back, so ungrabbed ranges are kept and handed out again (zeroed) when main
+// runs again on the same instance.
+static struct { void* address; uword size; } ungrabbed[4];
+
+void* OS::grab_virtual_memory(void* address, uword size) {
+  uword page = getpagesize();
+  size = Utils::round_up(size, page);
+  for (auto& range : ungrabbed) {
+    if (range.address != null && range.size == size) {
+      void* result = range.address;
+      range.address = null;
+      memset(result, 0, size);
+      return result;
+    }
+  }
+  void* result = sbrk(size + page);
+  if (result == reinterpret_cast<void*>(-1)) return null;
+  return reinterpret_cast<void*>(Utils::round_up(reinterpret_cast<uword>(result), page));
+}
+
+void OS::ungrab_virtual_memory(void* address, uword size) {
+  size = Utils::round_up(size, getpagesize());
+  for (auto& range : ungrabbed) {
+    if (range.address == null) {
+      range.address = address;
+      range.size = size;
+      return;
+    }
+  }
+}
+#else
 void* OS::grab_virtual_memory(void* address, uword size) {
   size = Utils::round_up(size, getpagesize());
   void* result = mmap(address, size,
@@ -69,6 +120,7 @@ void OS::ungrab_virtual_memory(void* address, uword size) {
