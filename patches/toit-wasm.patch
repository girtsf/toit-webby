+#ifdef TOIT_NO_THREADS
+bool TimerEventSource::poll(bool block) {
+  Locker locker(mutex());
+  if (timers_.is_empty()) return false;
+  if (block) {
+    int64 delay_us = timers_.first()->timeout() - OS::get_system_time();
+    if (delay_us > 0) {
+      Unlocker unlocker(locker);
+      usleep(delay_us);
+    }
+  }
+  int64 time = OS::get_system_time();  // Must match Time.monotonic-us.
+  while (!timers_.is_empty() && timers_.first()->timeout() <= time) {
+    dispatch(locker, timers_.remove_first(), 0);
+  }
+  return true;
+}
+#endif
